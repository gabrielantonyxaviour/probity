{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true, "skipLibCheck": true,
    "resolveJsonModule": true, "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "types": ["node"], "baseUrl": ".",
    "paths": { "@schemas/*": ["app/schemas/*"] }
  },
  "include": ["app", "services", "scripts", "tests", "bench", "db/seed", "*.ts"],
  "exclude": ["ui", "video", "node_modules", "vendor/meterless", "tests/engines/*/runner.ts"]
}
