# Probity. Copy to .env (or .env.local) for live runs. Never commit real values.
# Values in <angle brackets> are placeholders and are treated as unset.
# Judges: no .env is needed. `SAMPLE_MODE=true docker compose --profile sample up --build` runs offline.
# Default mode is live: without keys, /readyz is 503 and POST /run returns 503 live_unconfigured.

# ---- Mode and logging ----
SAMPLE_MODE=false
LOG_LEVEL=info
LOG_FORMAT=pretty                         # pretty | json

# ---- API ----
HOST=0.0.0.0
PORT=8787
RUN_BUDGET_SECONDS=480
MAX_CONCURRENT_RUNS=2
MAX_UPLOAD_MB=8
ENABLE_TEST_HOOKS=true                    # allows options.simulate_outage (always labelled)

# ---- Paths (relative to the repo root) ----
LOG_DIR=logs
# WORLD_DIR=.                             # optional, no default: unset -> "." live, os.tmpdir()/probity-sample in SAMPLE_MODE
HMEM_DIR=data/hmem
SAMPLE_DATA_DIR=data/sample
UPLOAD_DIR=uploads
INPUT_EXAMPLES_DIR=input_examples
TESSDATA_DIR=app/vendor/tessdata

# ---- Zetaris (local Docker). Create the key(s) in the Zetaris UI ----
ZETARIS_API_ORIGIN=http://localhost:8888   # API origin only; the adapter appends /api/v1.0/sql-editor/sqls/run
ZETARIS_UI_ORIGIN=http://localhost:3000    # web-UI origin, read only when ZETARIS_ROUTE=ui_proxy
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=<zetaris-api-key>          # alias: fills ZETARIS_ADMIN_API_KEY and ZETARIS_QUERY_API_KEY when those are unset
ZETARIS_QUERY_API_KEY=<zetaris-query-key>
ZETARIS_ADMIN_API_KEY=<zetaris-admin-key>
ZETARIS_SQL_TIMEOUT_MS=45000
ZETARIS_DDL_TIMEOUT_MS=120000             # run time; setup scripts accept up to 600000
ZETARIS_ROW_LIMIT=500
ZETARIS_MAX_CONCURRENCY=3
ZETARIS_DOWN_POLICY=degrade               # degrade | error
ZETARIS_ROUTE=api                         # api | ui_proxy
ZETARIS_DOCKER_NETWORK=zetaris_default
ERP_PATH=jdbc                             # jdbc | gateway
REGISTRY_USL_PATH=rest                    # rest | stage
REGISTRY_PATH=direct                      # direct | gateway
CHILDREN_SHAPE=rows                       # rows | wrapped
PREREGISTER_DISCOVERY=false

# ---- Model provider (Nebius x NVIDIA branch): nebius (default) or meterless ----
MODEL_PROVIDER=nebius
NEBIUS_API_KEY=<nebius-token-factory-key>   # from the vault: ~/.claude/vault/inject.sh get NEBIUS_API_KEY --dir .
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/
HOSTED_DEMO=false                    # true: Zetaris results replay from recordings, ERP in memory, models stay live (no Zetaris, Postgres or Nightshift needed)

# ---- Meterless Nightshift (used only when MODEL_PROVIDER=meterless) (token from the vault; the NVIDIA key stays in Nightshift > Providers) ----
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=<nightshift-runtime-token>
METERLESS_APP_ID=probity
METERLESS_SCOPE=app                  # app or user; app keeps Nightshift H-MEM from injecting earlier answers across runs
# LANE_FAST_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # gateway ids; leave unset on nebius (the table in app/config/providers.ts applies)
# LANE_DEEP_MODEL=nvidia/nemotron-3-ultra-550b-a55b
LANE_VISION_MODEL=                        # leave empty: no image path to NVIDIA on this Nightshift edition
L1_TOOL_MODE=native                       # native | json
REASONING_CONTROL=kwargs                  # kwargs | system | none
MODEL_TIMEOUT_MS=90000
MODEL_FIRST_CALL_TIMEOUT_MS=180000

# ---- Public registries (keyless). SEC requires a contact; use a team alias, never a personal address ----
SEC_USER_AGENT=<SEC_USER_AGENT>           # "Probity <team-alias@a-domain-you-control>"; no default
USASPENDING_BASE_URL=https://api.usaspending.gov
SEC_DATA_BASE_URL=https://data.sec.gov

# ---- Synthetic ERP (Postgres in compose profile live) ----
POSTGRES_PASSWORD=<local-postgres-owner-password>
PAYEE_APP_PASSWORD=<local-payee-app-password>
ERP_ZETARIS_READER_PASSWORD=<local-zetaris-reader-password>
ERP_DATABASE_URL=postgres://payee_app:<local-payee-app-password>@localhost:55432/payee_erp

# ---- Fallback gateway ----
SOURCE_GATEWAY_URL=http://localhost:8790

# ---- Engines ----
ENABLE_HMEM=false                         # H-MEM is COULD

# ---- Docker networking (Colima resolves host.docker.internal natively; no extra_hosts) ----
ZETARIS_API_ORIGIN_CONTAINER=http://host.docker.internal:8888
METERLESS_BASE_URL_CONTAINER=http://host.docker.internal:8088/v1
PAYEE_API_PORT=8787
PAYEE_UI_PORT=3100
PAYEE_GATEWAY_PORT=8790

# ---- UI ----
PAYEE_API_URL=http://localhost:8787
