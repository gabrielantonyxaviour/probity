{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "ES2023"], "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "skipLibCheck": true, "esModuleInterop": true, "isolatedModules": true,
    "resolveJsonModule": true, "types": ["node"], "baseUrl": ".", "paths": { "@schemas/*": ["../app/schemas/*"] }
  },
  "include": ["src", "scripts", "remotion.config.ts"]
}
