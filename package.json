{
  "name": "probity",
  "version": "0.1.0",
  "private": true,
  "description": "Before the money moves, prove who is asking. Vendor bank-change verification for accounts payable.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12 <25"
  },
  "bin": {
    "probity": "bin/probity.mjs"
  },
  "workspaces": [
    "app",
    "services/source-gateway",
    "ui",
    "video"
  ],
  "scripts": {
    "setup": "tsx scripts/setup.ts",
    "gen:seed": "tsx scripts/make_seed.ts",
    "gen:docs": "tsx scripts/make_documents.ts",
    "gen:all": "npm run gen:seed && npm run gen:docs",
    "gen:check": "tsx scripts/gen-check.ts",
    "capture:registry": "tsx scripts/capture_registry.ts",
    "capture:check": "tsx scripts/capture_registry.ts --check",
    "db:reset": "bash db/reset.sh",
    "zetaris:gen": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/gen-register-sql.ts",
    "zetaris:register": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/register.ts",
    "zetaris:stage-registry": "node --env-file-if-exists=.env.local --env-file-if-exists=.env.db.local --import tsx scripts/zetaris/stage-registry.ts",
    "zetaris:compile-jdbc": "bash scripts/zetaris/jdbc-compile.sh",
    "zetaris:history": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/capture-history.ts",
    "zetaris:capture": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/register.ts --only P8",
    "zetaris:check": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/register.ts --only P0",
    "zetaris:cleanup": "node --env-file-if-exists=.env.local --import tsx scripts/zetaris/cleanup.ts",
    "live:up": "set -a; . ./.env.db.local; set +a; docker compose -f docker-compose.yml -f docker-compose.live.yml --profile live up -d --build && bash scripts/docker/attach-zetaris.sh",
    "sample:up": "SAMPLE_MODE=true docker compose --profile sample up -d --build",
    "dev:api": "tsx watch app/api/server.ts",
    "dev:gateway": "tsx watch services/source-gateway/server.ts",
    "dev:ui": "PAYEE_API_URL=http://localhost:8787 npm --prefix ui run dev -- -p 3100",
    "cli": "node --import tsx app/cli/main.ts",
    "sample": "SAMPLE_MODE=true node --import tsx app/cli/main.ts run",
    "warmup": "node --import tsx app/cli/main.ts warmup",
    "smoke": "tsx scripts/smoke.ts",
    "record:examples": "ZETARIS_DOWN_POLICY=error tsx scripts/record_examples.ts",
    "demo": "npm run live:up && npm run zetaris:check && npm run warmup && echo \"UI http://localhost:3100\"",
    "demo:sessions": "node --import tsx app/cli/demo-sessions.ts",
    "bench:direct": "tsx bench/direct-fetch.ts -- --vendor V-10027",
    "eval:nemotron": "vitest run tests/eval/nemotron",
    "verify:registry": "tsx scripts/verify-registry-facts.ts",
    "test": "vitest run tests/unit tests/engines && npm run zetaris:test && npm run test:conformance",
    "test:conformance": "WORLD_MODEL_IMPL=$PWD/app/engines/world-model/index.ts npx tsx tests/engines/world-model/runner.ts && ( [ ! -f app/engines/hmem/index.ts ] || HMEM_IMPL=$PWD/app/engines/hmem/index.ts npx tsx tests/engines/hmem/runner.ts )",
    "test:engines": "npm run test:conformance && vitest run tests/engines",
    "test:integration": "LIVE=1 vitest run tests/integration",
    "test:e2e:api": "vitest run tests/e2e/api",
    "test:e2e:ui": "playwright test",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:ui",
    "test:parity": "LIVE=1 vitest run tests/parity",
    "eval": "tsx tests/eval/run.ts --mode sample",
    "judge:sim": "bash tests/judge/judge-sim.sh",
    "kill": "bash scripts/kill/run-all.sh",
    "regress": "bash scripts/regress.sh",
    "typecheck": "tsc -p tsconfig.json && npm --prefix ui run typecheck",
    "typecheck:video": "npm --prefix video run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:lines": "tsx scripts/check-lines.ts",
    "check:secrets": "bash scripts/check-secrets.sh",
    "inbox:prime": "tsx scripts/gen/prime-inbox.ts",
    "gateway:probe": "tsx scripts/gen/probe-gateway-zetaris.ts",
    "test:platform": "vitest run tests/unit/nightshift tests/unit/api tests/unit/cli tests/unit/trace",
    "zetaris:test": "node --env-file-if-exists=.env.local ./node_modules/vitest/vitest.mjs run --config scripts/zetaris/vitest.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@expo-google-fonts/ibm-plex-mono": "0.4.1",
    "@expo-google-fonts/ibm-plex-sans": "0.4.1",
    "@playwright/test": "1.55.1",
    "@types/node": "22.20.5",
    "@types/opentype.js": "1.3.10",
    "@types/pdfkit": "0.17.6",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "opentype.js": "1.3.4",
    "pdfkit": "0.20.2",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "3.2.7"
  }
}
